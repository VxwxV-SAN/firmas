<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FirmasPDF</AssemblyName>
    <RootNamespace>FirmasPDF</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Firmas PDF</Product>
    <Description>Visor de PDF, firmas visuales y firma digital para Windows.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
    <None Include="..\README.md" Link="LEEME.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
