<ui:DarkWindow x:Class="FirmasPDF.Views.SignatureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FirmasPDF.Views"
        Width="760" Height="555" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="25" FontWeight="SemiBold" />
            <TextBlock x:Name="Subtitle" Style="{StaticResource MutedText}" Margin="0,8,0,20" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Nombre de la firma" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBox x:Name="NameInput" Grid.Column="1" MaxLength="80" Text="Mi firma" />
        </Grid>
        <Grid x:Name="DrawingToolbar" Grid.Row="2" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Button Content="Negro" Tag="#19202E" Click="Color_Click" Padding="11,7" Margin="0,0,6,0" />
                <Button Content="Azul" Tag="#164C9C" Click="Color_Click" Padding="11,7" Margin="0,0,6,0" />
                <TextBlock Text="Grosor" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,10,0" />
                <Slider x:Name="Thickness" Width="95" Minimum="1.5" Maximum="8" Value="3" VerticalAlignment="Center"
                        ValueChanged="Thickness_Changed" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UndoButton" Content="Deshacer" Click="Undo_Click" Padding="10,7" Margin="0,0,6,0" />
                <Button x:Name="RedoButton" Content="Rehacer" Click="Redo_Click" Padding="10,7" Margin="0,0,6,0" />
                <Button Content="Limpiar" Click="Clear_Click" Padding="10,7" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="3" Background="#FCFCFF" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid x:Name="DrawingPanel" Margin="12">
                    <Border Height="1" Background="#DDE1EE" VerticalAlignment="Bottom" Margin="20,0,20,45" IsHitTestVisible="False" />
                    <TextBlock x:Name="DrawingHint" Text="Dibuja tu firma aquí" FontSize="21" Foreground="#ABB2C7"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <InkCanvas x:Name="DrawingSurface" Background="Transparent" EditingMode="Ink" ClipToBounds="True" />
                </Grid>
                <Image x:Name="ImportPreview" Margin="24" Stretch="Uniform" Visibility="Collapsed" />
            </Grid>
        </Border>
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="DrawingFooter" Text="El dibujo se recortará y se guardará con fondo transparente." Style="{StaticResource MutedText}" />
            <CheckBox x:Name="RemoveWhite" Content="Quitar fondo blanco y recortar márgenes" IsChecked="True" Visibility="Collapsed"
                      Checked="RemoveWhite_Changed" Unchecked="RemoveWhite_Changed" />
        </Grid>
        <Grid Grid.Row="5" Margin="0,20,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#FFAFB3" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" Margin="0,0,10,0" />
                <Button Content="Guardar firma" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:DarkWindow>
