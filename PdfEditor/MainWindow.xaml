<ui:DarkWindow x:Class="PdfEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PdfEditor.Views"
        xmlns:controls="clr-namespace:PdfEditor.Controls"
        Title="{Binding WindowTitle}" Width="1280" Height="850" MinWidth="1060" MinHeight="650"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewMouseWheel="Window_MouseWheel">
    <ui:DarkWindow.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenPdfCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCopyCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SignDigitallyCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicatePlacementCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemovePlacementCommand}" />
        <KeyBinding Key="PageDown" Modifiers="Control" Command="{Binding NextPageCommand}" />
        <KeyBinding Key="PageUp" Modifiers="Control" Command="{Binding PreviousPageCommand}" />
    </ui:DarkWindow.InputBindings>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="80" /><RowDefinition Height="*" /><RowDefinition Height="43" /></Grid.RowDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentSurfaceBrush}" Margin="0,0,13,0">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PDF Editor" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="Edita, firma y guarda tus PDFs." Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Abrir PDF" Command="{Binding OpenPdfCommand}" Margin="0,0,10,0" Padding="20,11" ToolTip="Abrir documento · Ctrl+O" />
                    <Border Width="1" Background="{StaticResource StrokeBrush}" Margin="6,5,16,5" />
                    <Button Content="Guardar copia" Command="{Binding SaveCopyCommand}" Margin="0,0,10,0" Padding="20,11" ToolTip="Guardar ediciones y firmas · Ctrl+S" />
                    <Button Content="Firmar digitalmente" Style="{StaticResource PrimaryButton}" Command="{Binding SignDigitallyCommand}"
                            Padding="20,11" ToolTip="Firmar con un certificado · Ctrl+Mayús+S" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270" MinWidth="245" MaxWidth="380" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16,18,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Content="Editar" Command="{Binding SetLeftTabCommand}" CommandParameter="0" Padding="8,8" />
                        <Button Grid.Column="2" Content="Firmas" Command="{Binding SetLeftTabCommand}" CommandParameter="1" Padding="8,8" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEditTab, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <TextBlock Text="HERRAMIENTAS" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Editar PDF" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,12" />
                            <Button Content="Seleccionar" Command="{Binding SetToolCommand}" CommandParameter="Select" Margin="0,0,0,8" Padding="10,9" />
                            <Button Content="Texto" Command="{Binding SetToolCommand}" CommandParameter="Text" Margin="0,0,0,8" Padding="10,9" />
                            <Button Content="Imagen" Command="{Binding SetToolCommand}" CommandParameter="Image" Margin="0,0,0,8" Padding="10,9" />
                            <Button Content="Firma" Command="{Binding SetToolCommand}" CommandParameter="Signature" Margin="0,0,0,14" Padding="10,9" />
                            <TextBlock Text="Clic en la página con Texto o Imagen para insertar. Selecciona un texto detectado para editarlo (Nativo o Tapar)."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="19" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Visibility="{Binding IsSignaturesTab, Converter={StaticResource BoolVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="TU BIBLIOTECA" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Mis firmas" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,5" />
                            <TextBlock Text="{Binding SignatureCountLabel}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,16,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="+ Crear" Command="{Binding DrawSignatureCommand}" ToolTip="Dibujar una nueva firma" Padding="9,9" />
                            <Button Grid.Column="2" Content="Importar" Command="{Binding ImportSignatureCommand}" ToolTip="Importar PNG o JPG" Padding="9,9" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <ListBox x:Name="SignatureList" ItemsSource="{Binding Signatures}" SelectedItem="{Binding SelectedAsset}"
                                     IsEnabled="{Binding CanInteract}" PreviewMouseLeftButtonDown="Library_MouseDown" PreviewMouseMove="Library_MouseMove"
                                     MouseDoubleClick="Library_DoubleClick" Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Border Background="#FAFAFD" CornerRadius="5" Height="84" Padding="12" Margin="0,0,0,11">
                                                <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding KindLabel}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolVisibility}}" Margin="6,0">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="30" HorizontalAlignment="Center" />
                                <TextBlock Text="Tu firma, siempre a mano" FontWeight="SemiBold" TextAlignment="Center" Margin="0,18,0,9" />
                                <TextBlock Text="Dibújala o importa una imagen.&#x0a;Después podrás reutilizarla aquí." Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="3" Margin="0,14,0,0">
                            <Button Content="Colocar firma seleccionada" Command="{Binding PlaceSignatureCommand}" Padding="8,10" />
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Content="Renombrar" Command="{Binding RenameSignatureCommand}" Padding="7,7" FontSize="11" />
                                <Button Grid.Column="2" Content="Eliminar" Command="{Binding DeleteSignatureCommand}" Padding="7,7" FontSize="11" />
                            </Grid>
                        </StackPanel>
                        <Border Grid.Row="4" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                            <TextBlock Text="Arrastra una firma al PDF o haz doble clic para colocarla." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="19" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BackgroundBrush}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Background="#151B27">
                    <Grid Margin="20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding PreviousPageCommand}" ToolTip="Página anterior · Ctrl+RePág" />
                            <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="13,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NextPageCommand}" ToolTip="Página siguiente · Ctrl+AvPág" />
                            <Border Width="1" Background="{StaticResource StrokeBrush}" Margin="18,4" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Command="{Binding UndoCommand}" ToolTip="Deshacer · Ctrl+Z" Margin="0,0,5,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE7A6;" Command="{Binding RedoCommand}" ToolTip="Rehacer · Ctrl+Y" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE738;" Click="ZoomOut_Click" IsEnabled="{Binding HasDocument}" ToolTip="Reducir zoom" />
                            <TextBlock Text="{Binding ZoomLabel}" Width="58" TextAlignment="Center" VerticalAlignment="Center" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE710;" Click="ZoomIn_Click" IsEnabled="{Binding HasDocument}" ToolTip="Aumentar zoom" />
                            <Button Content="Ajustar ancho" Click="FitWidth_Click" IsEnabled="{Binding HasDocument}" Padding="10,7" Margin="12,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="24,9,24,0">
                    <StackPanel>
                        <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DocumentHint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="DocumentScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  SizeChanged="Viewport_SizeChanged" Visibility="{Binding HasDocument, Converter={StaticResource BoolVisibility}}">
                        <Border x:Name="PageBorder" Margin="30,24" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White">
                            <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.28" /></Border.Effect>
                            <Grid x:Name="PageSurface" Width="{Binding PageWidth}" Height="{Binding PageHeight}" Background="Transparent"
                                  AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop" MouseLeftButtonDown="Page_MouseDown">
                                <Grid.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" /></Grid.LayoutTransform>
                                <Image Source="{Binding PageBitmap}" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
                                <ItemsControl ItemsSource="{Binding VisibleEditObjects}" IsEnabled="{Binding CanEdit}"
                                              Width="{Binding PageWidth}" Height="{Binding PageHeight}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                            <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:EditObjectControl Selected="EditObject_Selected" EditStarted="EditObject_EditStarted"
                                                                        EditCompleted="EditObject_EditCompleted" TextEdited="EditObject_TextEdited" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding VisiblePlacements}" IsEnabled="{Binding CanEdit}"
                                              Width="{Binding PageWidth}" Height="{Binding PageHeight}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                            <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:SignaturePlacementControl Selected="Placement_Selected" EditStarted="Placement_EditStarted"
                                                                                EditCompleted="Placement_EditCompleted" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolVisibility}}">
                        <Border Width="98" Height="98" CornerRadius="28" Background="{StaticResource AccentSurfaceBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xEA90;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Tu próximo PDF, listo para editar" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" Margin="0,25,0,12" />
                        <TextBlock Text="Abre un documento para editar texto e imágenes o firmarlo." Style="{StaticResource MutedText}" TextAlignment="Center" />
                        <TextBlock Text="También puedes arrastrar un archivo PDF a esta ventana." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,25" />
                        <Button Content="Abrir un PDF" Command="{Binding OpenPdfCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="30,13" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,35,0,0">
                            <TextBlock Text="01  Abre" Style="{StaticResource MutedText}" Margin="0,0,24,0" />
                            <TextBlock Text="02  Edita o firma" Style="{StaticResource MutedText}" Margin="0,0,24,0" />
                            <TextBlock Text="03  Guarda" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#C910141E" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="280">
                            <StackPanel>
                                <TextBlock Text="{Binding Status}" TextAlignment="Center" Margin="0,0,0,14" TextWrapping="Wrap" MaxWidth="420" />
                                <ProgressBar Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="{StaticResource RaisedBrush}" BorderThickness="0" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
                <Border Grid.Row="3" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Background="#151B27">
                    <Grid Margin="20,0">
                        <TextBlock Text="{Binding SelectionLabel}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,320,0" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowTextProperties, Converter={StaticResource BoolVisibility}}" Margin="0,0,10,0">
                                <TextBlock Text="Tamaño" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Width="44" Text="{Binding SelectedEditObject.FontSizeDip, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,3" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="Reemplazar imagen" Command="{Binding ReplaceSelectedImageCommand}" FontSize="11" Padding="10,5" Margin="0,0,7,0"
                                    Visibility="{Binding ShowImageProperties, Converter={StaticResource BoolVisibility}}" />
                            <Button Content="Duplicar" Command="{Binding DuplicatePlacementCommand}" FontSize="11" Padding="10,5" Margin="0,0,7,0" />
                            <Button Content="Quitar" Command="{Binding RemovePlacementCommand}" FontSize="11" Padding="10,5" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Content="Ver PDF guardado" Command="{Binding OpenExportCommand}" FontSize="11" Padding="10,5" Margin="12,0"
                        VerticalAlignment="Center" Visibility="{Binding HasExport, Converter={StaticResource BoolVisibility}}" />
                <TextBlock Grid.Column="3" Text="{Binding PlacementCountLabel}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</ui:DarkWindow>
