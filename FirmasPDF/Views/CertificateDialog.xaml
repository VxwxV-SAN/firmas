<ui:DarkWindow x:Class="FirmasPDF.Views.CertificateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FirmasPDF.Views"
        Title="Firma digital" Width="620" Height="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="300" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="Firma digital con certificado" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Elige tu certificado y revisa los datos de la firma." Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        </StackPanel>
        <TabControl x:Name="SourceTabs" Grid.Row="1" SelectionChanged="SourceTabs_Changed">
            <TabItem Header="Archivo PFX / P12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Archivo de certificado" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <DockPanel>
                        <Button Content="Buscar…" DockPanel.Dock="Right" Margin="8,0,0,0" Click="Browse_Click" />
                        <TextBox x:Name="FileInput" IsReadOnly="True" ToolTip="Selecciona un certificado PFX o P12" />
                    </DockPanel>
                    <TextBlock Text="Contraseña" Style="{StaticResource SectionLabel}" Margin="0,14,0,8" />
                    <DockPanel>
                        <Button Content="Revisar certificado" DockPanel.Dock="Right" Margin="8,0,0,0" Click="LoadPfx_Click" />
                        <PasswordBox x:Name="PasswordInput" PasswordChanged="Password_Changed" />
                    </DockPanel>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                        <TextBlock x:Name="PfxDetails" Text="Carga el archivo para revisar el titular y la fecha de validez."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" />
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Certificados de Windows">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button Content="Actualizar" DockPanel.Dock="Right" Click="Refresh_Click" Padding="10,5" />
                        <TextBlock Text="Certificados personales con clave privada" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="StoreList" Grid.Row="1" SelectionChanged="StoreList_Changed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding Issuer, StringFormat=Emisor: {0}}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyStore" Grid.Row="1" Text="No hay certificados válidos con clave privada en los almacenes personales de Windows."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14" Visibility="Collapsed" />
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Motivo" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                <TextBox x:Name="ReasonInput" Text="Aprobación del documento" MaxLength="150" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Lugar (opcional)" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                <TextBox x:Name="LocationInput" MaxLength="120" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,18,0,0">
            <StackPanel>
                <CheckBox x:Name="UseAppearance" Content="Usar la firma seleccionada como apariencia digital" IsChecked="True" />
                <TextBlock x:Name="AppearanceDescription" Style="{StaticResource MutedText}" Margin="28,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="#FFAFB3" TextWrapping="Wrap" Margin="0,12,0,8" VerticalAlignment="Center" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" Margin="0,0,10,0" />
            <Button x:Name="UseButton" Content="Firmar y guardar" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="Use_Click" IsEnabled="False" />
        </StackPanel>
    </Grid>
</ui:DarkWindow>
