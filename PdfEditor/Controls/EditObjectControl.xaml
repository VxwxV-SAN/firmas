<UserControl x:Class="PdfEditor.Controls.EditObjectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
             PreviewMouseLeftButtonDown="Select_MouseDown">
    <UserControl.Resources>
        <Style x:Key="MoveThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResizeThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource AccentBrush}" BorderBrush="White" BorderThickness="1" CornerRadius="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border Background="#66FFFFFF" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False" />
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 Background="#E6FFFFFF" BorderThickness="0" TextWrapping="Wrap"
                 FontSize="{Binding FontSizeDip}" AcceptsReturn="True"
                 Visibility="{Binding IsTextKind, Converter={StaticResource BoolVisibility}}"
                 LostFocus="Text_LostFocus" />
        <Image Source="{Binding Image}" Stretch="Fill" IsHitTestVisible="False"
               Visibility="{Binding IsImageKind, Converter={StaticResource BoolVisibility}}" />
        <Border Background="#CC1B2435" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="2" IsHitTestVisible="False"
                Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding ModeBadge}" Foreground="White" FontSize="10" />
        </Border>
        <Thumb Style="{StaticResource MoveThumb}" Cursor="SizeAll" DragStarted="Thumb_Started"
               DragDelta="Move_Delta" DragCompleted="Thumb_Completed" />
        <Thumb Style="{StaticResource ResizeThumb}" Cursor="SizeNWSE" Width="12" Height="12"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}"
               DragStarted="Thumb_Started" DragDelta="Resize_Delta" DragCompleted="Thumb_Completed" />
    </Grid>
</UserControl>
